{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/.schema/config.schema.json",
  "productName": "柒号收银",
  "version": "3.2.0",
  "identifier": "com.qihhao.cashier",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../../软件源/静态资源/html",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "title": "柒号收银",
    "windows": [
      {
        "label": "main",
        "title": "柒号收银系统",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:*; script-src 'self' 'unsafe-inline' http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "deb": { "depends": [] },
    "externalBin": ["../收银系统sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "identifier": "com.qihhao.cashier",
    "longDescription": "柒号离线收银系统 v3.2.0",
    "macOS": {
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "resources": ["../../软件源/静态资源/"],
    "shortDescription": "离线收银系统",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
